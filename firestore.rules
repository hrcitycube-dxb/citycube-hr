rules_version = '2';

// CityCube Group HR — Cloud Firestore security rules.
// Two roles, stored in /users/{uid}:
//   role "admin"    → HR staff: full read/write on every company.
//   role "employee" → own employee record, own leave, own payslips only.
// A login with active == false is blocked everywhere.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile()    { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive()   { return profile().get('active', true) == true; }
    function isAdmin()    { return hasProfile() && profile().role == 'admin' && isActive(); }
    function isEmployee() { return hasProfile() && profile().role == 'employee' && isActive(); }
    function myEmpId()    { return profile().empId; }

    // Login profiles. Users may read their own; only HR admins create or change them.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Reference data employees need to count leave days (rest days, holidays).
    match /companies/{id} {
      allow read: if isAdmin() || isEmployee();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isAdmin() || isEmployee();
      allow write: if isAdmin();
    }

    // An employee can read only their own record.
    match /employees/{id} {
      allow read: if isAdmin() || (isEmployee() && id == myEmpId());
      allow write: if isAdmin();
    }

    // Leave: employees may create a pending request for themselves and cancel it
    // while it is still pending. Only HR approves, rejects, edits or deletes.
    match /leaves/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.empId == myEmpId());

      allow create: if isAdmin() || (
        isEmployee()
        && request.resource.data.id == id
        && request.resource.data.empId == myEmpId()
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['id','empId','type','from','to','note','ref','status','source','created','requestedBy','fileId','updatedAt'])
        && request.resource.data.type in ['annual','sick','unpaid','maternity','comp']
        && request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.from <= request.resource.data.to
        && request.resource.data.note.size() <= 500
        && request.resource.data.ref.size() <= 80
      );

      allow update: if isAdmin() || (
        isEmployee()
        && resource.data.empId == myEmpId()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
      );

      allow delete: if isAdmin();
    }

    // Published payslips (written by HR when payroll is finalised).
    match /payslips/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.empId == myEmpId());
      allow write: if isAdmin();
    }

    // Document files: metadata in /files, contents split into /fileChunks (max ~900 KB each).
    // Employees may read their own and upload new ones for HR to check; only HR edits or deletes.
    match /files/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.empId == myEmpId());
      allow create: if isAdmin() || (
        isEmployee()
        && request.resource.data.id == id
        && request.resource.data.empId == myEmpId()
        && request.resource.data.status == 'review'
        && request.resource.data.byRole == 'employee'
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 8
        && request.resource.data.keys().hasOnly(['id','empId','docType','expiry','note','status','mime','size','chunks','name','created','uploadedBy','byRole','updatedAt'])
      );
      allow update, delete: if isAdmin();
    }
    match /fileChunks/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.empId == myEmpId());
      allow create: if isAdmin() || (
        isEmployee()
        && request.resource.data.id == id
        && request.resource.data.empId == myEmpId()
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.keys().hasOnly(['id','fileId','empId','i','data','updatedAt'])
      );
      allow update, delete: if isAdmin();
    }

    // Full-size employee photos (a small copy is kept on the employee record).
    match /photos/{id} {
      allow read: if isAdmin() || (isEmployee() && id == myEmpId());
      allow write: if isAdmin();
    }

    // HR-only data.
    match /payruns/{id}     { allow read, write: if isAdmin(); }
    match /loans/{id}       { allow read, write: if isAdmin(); }
    match /settlements/{id} { allow read, write: if isAdmin(); }

    // Anything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
